<Project Sdk="Microsoft.NET.Sdk.Web">
<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    
  <!-- Enable NuGet Packaging -->
  <IsPackable>true</IsPackable>
    
  <!-- NuGet Package Properties -->
  <PackageId>UmbracoContentActivity</PackageId>
  <Version>1.0.0</Version>
  <Authors>Manv</Authors>
  <Company>Umbraco</Company>
  <Product>Umbraco Content Activity Tracker</Product>
  <Description>Content Activity Tracker Dashboard for Umbraco 17 CMS.</Description>
  <PackageTags>Umbraco;Dashboard;ContentTracking;ActivityLog;SignalR;Umbraco17</PackageTags>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <PackageProjectUrl>https://github.com/ManhOptimizely/UmbracoDashboardDemo</PackageProjectUrl>
  <RepositoryUrl>https://github.com/ManhOptimizely/UmbracoDashboardDemo</RepositoryUrl>
  <RepositoryType>git</RepositoryType>
  <PackageReadmeFile>README.md</PackageReadmeFile>
  <Copyright>Copyright © 2026</Copyright>
    
  <!-- Include content files in package -->
  <IncludeContentInPack>true</IncludeContentInPack>
  <ContentTargetFolders>content;contentFiles</ContentTargetFolders>
</PropertyGroup>
  
<ItemGroup>
  <!-- Include README in package -->
  <None Include="README.md" Pack="true" PackagePath="\" />
    
  <!-- Include App_Plugins content -->
  <Content Include="app_plugins\umbraco-package.json">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <PackagePath>contentFiles\any\net10.0\app_plugins\;content\app_plugins\</PackagePath>
    <Pack>true</Pack>
  </Content>
  <Content Include="App_Plugins\content-activity-tracker\content-activity-tracker-realtime.js">
    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    <PackagePath>contentFiles\any\net10.0\App_Plugins\content-activity-tracker\;content\App_Plugins\content-activity-tracker\</PackagePath>
    <Pack>true</Pack>
  </Content>
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.1.0" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
