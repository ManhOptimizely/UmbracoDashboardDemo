{
  "$schema": "../../umbraco-package-schema.json",
  "name": "My.WelcomePackage",
  "version": "0.1.0",
  "extensions": [
    {
      "type": "dashboard",
      "alias": "my.content.activity.tracker",
      "name": "Content Activity Tracker",
      "element": "/App_Plugins/content-activity-tracker/content-activity-tracker-realtime.js",
      "elementName": "content-activity-tracker",
      "weight": 20,
      "meta": {
        "label": "Content Activity",
        "pathname": "content-activity"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}